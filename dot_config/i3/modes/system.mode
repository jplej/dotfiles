# name: SYSTEM
# var: system
# color: #5E81AC
# trigger: $mod+s
# out: 31-system.conf
# icon	key	label	command
󰍉	f	find	~/.local/bin/rofi-search
󰅎	c	clip	rofi -modi "clipboard:greenclip print" -show clipboard
󰕾	s	sound	pavucontrol
󰂯	b	bluetooth	blueman-manager
󰤨	n	network	nm-connection-editor
󰌌	k	layout	~/.config/i3/layout-toggle.sh
